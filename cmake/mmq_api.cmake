# Select the MMQ calling convention from the selected dependency, independent
# of which model families are enabled. This module performs no compile probe.
if(NOT TARGET strata_mmq)
  return()
endif()
if(NOT DEFINED _strata_mmq)
  message(FATAL_ERROR "strata_mmq exists without its selected GGML MMQ directory")
endif()
foreach(_strata_header mmq.cuh common.cuh)
  if(NOT EXISTS "${_strata_mmq}/${_strata_header}")
    message(FATAL_ERROR "Selected GGML is missing ${_strata_mmq}/${_strata_header}")
  endif()
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${_strata_mmq}/mmq.cuh" "${_strata_mmq}/common.cuh")
file(SHA256 "${_strata_mmq}/mmq.cuh" _strata_mmq_sha)
file(SHA256 "${_strata_mmq}/common.cuh" _strata_common_sha)
file(READ "${_strata_mmq}/mmq.cuh" _strata_mmq_text)
string(REGEX REPLACE "[ \t\r\n]+" " " _strata_mmq_text "${_strata_mmq_text}")
set(_strata_config_prefix
  "static __host__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config[(]const ggml_type type, const int J, const bool fallback, const int cc")
set(_strata_case_suffix
  " *void mul_mat_q_case[(]ggml_backend_cuda_context *& *ctx, const mmq_args *& *args, cudaStream_t stream[)] *[{]")
set(_strata_prec_api FALSE)
set(_strata_legacy_api FALSE)
if(_strata_mmq_text MATCHES "${_strata_config_prefix}, const ggml_prec prec_src1[)] *[{]"
   AND _strata_mmq_text MATCHES "template *<ggml_type type, ggml_prec prec_src1>${_strata_case_suffix}")
  set(_strata_prec_api TRUE)
endif()
if(_strata_mmq_text MATCHES "${_strata_config_prefix}[)] *[{]"
   AND _strata_mmq_text MATCHES "template *<ggml_type type>${_strata_case_suffix}")
  set(_strata_legacy_api TRUE)
endif()
if(_strata_prec_api AND NOT _strata_legacy_api)
  set(_strata_mmq_api "explicit-prec-src1-q8")
elseif(_strata_legacy_api AND NOT _strata_prec_api)
  set(_strata_mmq_api "legacy-q8")
else()
  message(FATAL_ERROR
    "Unsupported or ambiguous selected MMQ declarations: ${_strata_mmq}/mmq.cuh (SHA256 ${_strata_mmq_sha})")
endif()
# Only these Strata translation units consume this compatibility macro.
# Keep quantize.cu and GGML's template-instance object recipes unchanged.
get_filename_component(_strata_mmq_source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_strata_source moe_mmq.cu native_q4_code_sum_mmq.cu)
  set(_strata_source "${_strata_mmq_source_root}/src/prefill/${_strata_source}")
  get_source_file_property(_strata_defs "${_strata_source}" COMPILE_DEFINITIONS)
  if(NOT _strata_defs)
    set(_strata_defs "")
  endif()
  list(FILTER _strata_defs EXCLUDE REGEX "^STRATA_DEEPSEEK_V4_GGML_API(=.*)?$")
  if(_strata_prec_api)
    list(APPEND _strata_defs STRATA_DEEPSEEK_V4_GGML_API=1)
  endif()
  set_source_files_properties("${_strata_source}" PROPERTIES COMPILE_DEFINITIONS "${_strata_defs}")
endforeach()
set(STRATA_MMQ_API_SIGNATURE "${_strata_mmq_api}" CACHE INTERNAL "Selected MMQ API" FORCE)
set(STRATA_MMQ_HEADER_SHA256 "${_strata_mmq_sha}" CACHE INTERNAL "Selected mmq.cuh SHA256" FORCE)
set(STRATA_MMQ_COMMON_SHA256 "${_strata_common_sha}" CACHE INTERNAL "Selected common.cuh SHA256" FORCE)
message(STATUS "Strata MMQ API: ${_strata_mmq_api}; ${_strata_mmq}")
message(STATUS "Strata MMQ headers: mmq=${_strata_mmq_sha}; common=${_strata_common_sha}")
