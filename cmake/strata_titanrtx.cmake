# Production-only P20 registration. Include once after the existing top-level targets are defined.
# This file neither configures/builds/runs nor imports old task/payload/qualification files.
include_guard(GLOBAL)
if(NOT TARGET strata_qwen35moe_runtime)
  return() # Native-dense-only or other non-Qwen35MoE configurations remain unchanged.
endif()
if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  message(FATAL_ERROR "strata_titanrtx.cmake must be included by the top-level project after target creation")
endif()
if(NOT STRATA_ENABLE_CUDA OR NOT STRATA_DEEPSEEK_V4)
  message(FATAL_ERROR "P20 Qwen35MoE production registration requires the existing CUDA and DeepSeek-V4 backend options")
endif()
foreach(_strata_titanrtx_required strata_qwen35moe_runtime strata_qwen35moe_cuda strata_kernels strata_mmq strata_prefill CUDA::cublas)
  if(NOT TARGET ${_strata_titanrtx_required})
    message(FATAL_ERROR "Missing existing production target: ${_strata_titanrtx_required}")
  endif()
endforeach()

