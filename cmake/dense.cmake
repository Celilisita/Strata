# Native small dense families share one model/state implementation across GPU backends.
# GGML targets below must be built from the unified dependency source in this build.
add_library(strata_dense_spec STATIC src/dense/spec.cpp src/dense/spec_bind.cpp)
target_compile_features(strata_dense_spec PUBLIC cxx_std_17)
target_include_directories(strata_dense_spec PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
add_executable(strata-dense-inspect src/dense/inspect.cpp)
target_link_libraries(strata-dense-inspect PRIVATE strata_dense_spec)

option(STRATA_DENSE_CUDA "Build the resident native dense CUDA model" OFF)
if(STRATA_DENSE_CUDA)
  foreach(_target ggml ggml-base ggml-cuda)
    if(NOT TARGET ${_target})
      message(FATAL_ERROR "Native dense requires source-built ${_target}; configure the unified backend first")
    endif()
    get_target_property(_dense_imported ${_target} IMPORTED)
    if(_dense_imported)
      message(FATAL_ERROR "Native dense refuses imported historical backend target ${_target}")
    endif()
  endforeach()
  add_library(strata_dense_cuda STATIC
    src/dense/model_weights.cpp src/dense/model_run.cpp
    src/dense/graph_attention.cpp src/dense/graph_qwen.cpp
    src/dense/half_cache.cpp src/dense/model_graph.cpp src/dense/visual.cpp
    src/dense/projection_pack.cpp src/dense/norm_fusion.cpp
    src/dense/compact_readback.cpp)
  target_compile_features(strata_dense_cuda PUBLIC cxx_std_17)
  target_link_libraries(strata_dense_cuda PUBLIC strata_dense_spec ggml ggml-base ggml-cuda)
  target_compile_definitions(strata_dense_cuda PUBLIC NOMINMAX)
  add_executable(strata-dense-engine src/dense/engine.cpp src/dense/sampling.cpp)
  target_compile_features(strata-dense-engine PRIVATE cxx_std_17)
  target_link_libraries(strata-dense-engine PRIVATE strata_dense_cuda)
  if(MSVC)
    target_compile_options(strata_dense_spec PRIVATE /utf-8 /W4)
    target_compile_options(strata_dense_cuda PRIVATE /utf-8 /W4)
    target_compile_options(strata-dense-engine PRIVATE /utf-8 /W4)
  endif()
endif()

# The image encoder is a normal helper linked from the same dependency source.
option(STRATA_BUILD_DENSE_VISION "Build the native dense image helper" OFF)
if(STRATA_BUILD_DENSE_VISION)
  foreach(_target mtmd llama)
    if(NOT TARGET ${_target})
      message(FATAL_ERROR "Dense vision requires source-built ${_target}")
    endif()
    get_target_property(_dense_imported ${_target} IMPORTED)
    if(_dense_imported)
      message(FATAL_ERROR "Dense vision refuses imported historical target ${_target}")
    endif()
  endforeach()
  add_executable(strata-dense-vision tools/vision/dense_vision.cpp)
  target_compile_features(strata-dense-vision PRIVATE cxx_std_17)
  target_link_libraries(strata-dense-vision PRIVATE mtmd llama)
  set_target_properties(strata-dense-vision PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  if(NOT STRATA_DENSE_BACKEND_SOURCE)
    if(STRATA_LLAMA_SOURCE_DIR)
      set(STRATA_DENSE_BACKEND_SOURCE "${STRATA_LLAMA_SOURCE_DIR}")
    elseif(STRATA_GGML_DIR)
      set(STRATA_DENSE_BACKEND_SOURCE "${STRATA_GGML_DIR}")
    elseif(strata_llamacpp_SOURCE_DIR)
      set(STRATA_DENSE_BACKEND_SOURCE "${strata_llamacpp_SOURCE_DIR}")
    endif()
  endif()
  if(NOT EXISTS "${STRATA_DENSE_BACKEND_SOURCE}/tools/mtmd/mtmd-helper.h")
    message(FATAL_ERROR "Set STRATA_DENSE_BACKEND_SOURCE to the source-built mtmd dependency root")
  endif()
  file(READ "${STRATA_DENSE_BACKEND_SOURCE}/tools/mtmd/mtmd-helper.h" _dense_mtmd_header)
  if(_dense_mtmd_header MATCHES "mtmd_helper_init_opt_default")
    target_compile_definitions(strata-dense-vision PRIVATE STRATA_MTMD_FILE_OPTIONS=1)
  endif()
  if(MSVC)
    target_compile_definitions(strata-dense-vision PRIVATE NOMINMAX)
    target_compile_options(strata-dense-vision PRIVATE /utf-8 /W4)
  endif()
endif()
