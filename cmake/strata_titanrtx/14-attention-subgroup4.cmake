if(NOT TARGET strata_qwen35moe_runtime OR NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "Rows64 subgroup4 requires actual Runtime and CUDA targets")
endif()
set(_strata_rows64_subgroup4_source "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64_subgroup4.cu")
get_target_property(_strata_rows64_subgroup4_sources strata_qwen35moe_runtime SOURCES)
get_target_property(_strata_rows64_subgroup4_dir strata_qwen35moe_runtime SOURCE_DIR)
set(_strata_rows64_subgroup4_new_count 0)
set(_strata_rows64_subgroup4_base_count 0)
foreach(_entry IN LISTS _strata_rows64_subgroup4_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_strata_rows64_subgroup4_dir}")
    if(_absolute STREQUAL _strata_rows64_subgroup4_source)
      math(EXPR _strata_rows64_subgroup4_new_count "${_strata_rows64_subgroup4_new_count}+1")
    endif()
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64.cu")
      math(EXPR _strata_rows64_subgroup4_base_count "${_strata_rows64_subgroup4_base_count}+1")
    endif()
  endif()
endforeach()
if(NOT _strata_rows64_subgroup4_base_count EQUAL 1 OR _strata_rows64_subgroup4_new_count GREATER 1)
  message(FATAL_ERROR "Expected exactly one actual Rows64 parent and at most one subgroup4 CU")
endif()
if(NOT _strata_rows64_subgroup4_new_count)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_strata_rows64_subgroup4_source}")
endif()
# No global or per-source option changes. Owner must compare complete actual parent/new CUDA edges.
