if(NOT TARGET strata_qwen35moe_runtime OR NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "Qpad8 requires actual Runtime/CUDA targets")
endif()
set(_qpad8_parent "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64.cu")
set(_qpad8_child "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64_qpad8.cu")
get_target_property(_qpad8_dir strata_qwen35moe_runtime SOURCE_DIR)
get_target_property(_qpad8_sources strata_qwen35moe_runtime SOURCES)
set(_qpad8_parent_count 0)
set(_qpad8_child_count 0)
foreach(_qpad8_entry IN LISTS _qpad8_sources)
  if(NOT _qpad8_entry MATCHES "^\\$<")
    get_filename_component(_qpad8_absolute "${_qpad8_entry}" ABSOLUTE BASE_DIR "${_qpad8_dir}")
    if(_qpad8_absolute STREQUAL _qpad8_parent)
      math(EXPR _qpad8_parent_count "${_qpad8_parent_count}+1")
    endif()
    if(_qpad8_absolute STREQUAL _qpad8_child)
      math(EXPR _qpad8_child_count "${_qpad8_child_count}+1")
    endif()
  endif()
endforeach()
if(NOT _qpad8_parent_count EQUAL 1 OR _qpad8_child_count GREATER 1)
  message(FATAL_ERROR "Qpad8 needs one actual Rows64 and at most one new CU")
endif()
if(NOT _qpad8_child_count)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_qpad8_child}")
endif()
# Copy source-level attributes in the owning target directory, without target/global overrides.
foreach(_qpad8_property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
  get_source_file_property(_qpad8_value "${_qpad8_parent}" TARGET_DIRECTORY strata_qwen35moe_runtime ${_qpad8_property})
  if(NOT _qpad8_value STREQUAL "NOTFOUND")
    set_source_files_properties("${_qpad8_child}" TARGET_DIRECTORY strata_qwen35moe_runtime PROPERTIES ${_qpad8_property} "${_qpad8_value}")
  endif()
endforeach()
# Owner must compare complete actual FLAGS/DEFINES/INCLUDES against actual Rows64 parent.
