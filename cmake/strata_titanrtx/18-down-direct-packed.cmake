if(NOT TARGET strata_mmq OR NOT TARGET strata_qwen35moe_runtime)
  message(FATAL_ERROR "Direct packed Down requires the actual production MMQ/Runtime targets")
endif()
get_target_property(_down_direct_sources strata_mmq SOURCES)
get_target_property(_down_direct_dir strata_mmq SOURCE_DIR)
set(_down_direct_base 0)
set(_down_direct_new 0)
foreach(_entry IN LISTS _down_direct_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_down_direct_dir}")
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/prefill/native_ordinary_grouped_mmq.cu")
      math(EXPR _down_direct_base "${_down_direct_base}+1")
    endif()
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/prefill/native_down_direct_packed.cu")
      math(EXPR _down_direct_new "${_down_direct_new}+1")
    endif()
  endif()
endforeach()
if(NOT _down_direct_base EQUAL 1 OR _down_direct_new GREATER 1)
  message(FATAL_ERROR "Direct packed Down must inherit exactly one existing ordinary MMQ parent")
endif()
# Source-specific parent fastmath/definitions/includes are policy, too.
set(_down_direct_parent "${CMAKE_SOURCE_DIR}/src/prefill/native_ordinary_grouped_mmq.cu")
set(_down_direct_candidate "${CMAKE_SOURCE_DIR}/src/prefill/native_down_direct_packed.cu")
foreach(_property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
  get_source_file_property(_down_direct_property "${_down_direct_parent}" TARGET_DIRECTORY strata_mmq ${_property})
  if(_down_direct_property AND NOT _down_direct_property MATCHES "NOTFOUND$")
    set_source_files_properties("${_down_direct_candidate}" TARGET_DIRECTORY strata_mmq PROPERTIES ${_property} "${_down_direct_property}")
  endif()
endforeach()
if(_down_direct_new EQUAL 0)
  target_sources(strata_mmq PRIVATE "${CMAKE_SOURCE_DIR}/src/prefill/native_down_direct_packed.cu")
endif()
