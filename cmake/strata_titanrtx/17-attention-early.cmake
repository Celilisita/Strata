if(NOT TARGET strata_qwen35moe_runtime OR NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "EarlyRows64 requires actual Runtime/CUDA targets")
endif()
set(_early_parent "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64.cu")
set(_early_child "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64_early.cu")
get_target_property(_early_dir strata_qwen35moe_runtime SOURCE_DIR)
get_target_property(_early_sources strata_qwen35moe_runtime SOURCES)
set(_early_parent_count 0)
set(_early_child_count 0)
foreach(_early_entry IN LISTS _early_sources)
  if(NOT _early_entry MATCHES "^\\$<")
    get_filename_component(_early_absolute "${_early_entry}" ABSOLUTE BASE_DIR "${_early_dir}")
    if(_early_absolute STREQUAL _early_parent)
      math(EXPR _early_parent_count "${_early_parent_count}+1")
    endif()
    if(_early_absolute STREQUAL _early_child)
      math(EXPR _early_child_count "${_early_child_count}+1")
    endif()
  endif()
endforeach()
if(NOT _early_parent_count EQUAL 1 OR _early_child_count GREATER 1)
  message(FATAL_ERROR "EarlyRows64 needs one actual Rows64 and at most one new CU")
endif()
if(NOT _early_child_count)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_early_child}")
endif()
# Copy source-level attributes in the owning target directory, without target/global overrides.
foreach(_early_property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
  get_source_file_property(_early_value "${_early_parent}" TARGET_DIRECTORY strata_qwen35moe_runtime ${_early_property})
  if(NOT _early_value STREQUAL "NOTFOUND")
    set_source_files_properties("${_early_child}" TARGET_DIRECTORY strata_qwen35moe_runtime PROPERTIES ${_early_property} "${_early_value}")
  endif()
endforeach()
# Owner must compare complete actual FLAGS/DEFINES/INCLUDES against actual Rows64 parent.
