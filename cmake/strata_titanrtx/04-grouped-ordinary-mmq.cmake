if(NOT TARGET strata_mmq)
  message(FATAL_ERROR "Grouped ordinary delta requires the existing production MMQ target")
endif()
get_target_property(_grouped_mma_defs strata_mmq COMPILE_DEFINITIONS)
if(NOT "STRATA_DEEPSEEK_V4_GGML_API=1" IN_LIST _grouped_mma_defs)
  message(FATAL_ERROR "Grouped ordinary delta requires the actual D4 private GGML ABI")
endif()
get_target_property(_grouped_mma_added strata_mmq STRATA_GROUPED_ORDINARY_REGISTERED)
if(NOT _grouped_mma_added)
  target_sources(strata_mmq PRIVATE "${CMAKE_SOURCE_DIR}/src/prefill/native_ordinary_grouped_mmq.cu")
  set_property(TARGET strata_mmq PROPERTY STRATA_GROUPED_ORDINARY_REGISTERED TRUE)
endif()
