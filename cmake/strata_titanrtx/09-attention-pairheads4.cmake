if(NOT TARGET strata_qwen35moe_cuda OR NOT TARGET strata_qwen35moe_runtime)
  message(FATAL_ERROR "PairHeads4 requires the actual native attention targets")
endif()
set(_strata_pairheads4_source "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_pairheads4.cu")
get_target_property(_strata_pairheads4_sources strata_qwen35moe_cuda SOURCES)
get_target_property(_strata_pairheads4_dir strata_qwen35moe_cuda SOURCE_DIR)
set(_strata_pairheads4_count 0)
set(_strata_pairheads4_baseline_count 0)
foreach(_entry IN LISTS _strata_pairheads4_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_strata_pairheads4_dir}")
    if(_absolute STREQUAL _strata_pairheads4_source)
      math(EXPR _strata_pairheads4_count "${_strata_pairheads4_count}+1")
    endif()
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/flash_attn_tile.cu")
      math(EXPR _strata_pairheads4_baseline_count "${_strata_pairheads4_baseline_count}+1")
    endif()
  endif()
endforeach()
if(NOT _strata_pairheads4_baseline_count EQUAL 1 OR _strata_pairheads4_count GREATER 1)
  message(FATAL_ERROR "PairHeads4 must share exactly one actual native tile target")
endif()
if(_strata_pairheads4_count EQUAL 0)
  target_sources(strata_qwen35moe_cuda PRIVATE "${_strata_pairheads4_source}")
endif()
# Inherit the actual native tile target unchanged. Owner must compare complete
# Ninja FLAGS/DEFINES/INCLUDES for native and new CU before any compilation.
