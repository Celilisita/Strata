# Inherit the original scan-preprocess CU target's effective CUDA17/fastmath policy.
# No raw CUDA_STANDARD property equality assumption or compile-flag mutation.
if(NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "ConvTime32 requires the original Qwen35MoE CUDA target")
endif()
set(_conv_time32_source "${CMAKE_SOURCE_DIR}/src/kernels/cuda/native_gdn_conv_time32.cu")
get_target_property(_conv_time32_sources strata_qwen35moe_cuda SOURCES)
get_target_property(_conv_time32_source_dir strata_qwen35moe_cuda SOURCE_DIR)
set(_conv_time32_count 0)
foreach(_source IN LISTS _conv_time32_sources)
  if(NOT _source MATCHES "^\\$<")
    get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_conv_time32_source_dir}")
    if(_absolute STREQUAL _conv_time32_source)
      math(EXPR _conv_time32_count "${_conv_time32_count}+1")
    endif()
  endif()
endforeach()
if(_conv_time32_count GREATER 1)
  message(FATAL_ERROR "Production must own at most one ConvTime32 CU")
elseif(_conv_time32_count EQUAL 0)
  target_sources(strata_qwen35moe_cuda PRIVATE "${_conv_time32_source}")
endif()
