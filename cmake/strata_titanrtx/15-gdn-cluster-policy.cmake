# Metadata-only fix, after original P15 production registration. No source writes.
if(NOT TARGET strata_kernels)
  message(FATAL_ERROR "P15 TG policy requires the actual native kernel target")
endif()
set(_p15_tg_policy_parent "${CMAKE_SOURCE_DIR}/src/kernels/cuda/native_gdn_preprocess.cu")
set(_p15_tg_policy_child "${CMAKE_SOURCE_DIR}/src/kernels/cuda/native_gdn_cluster.cu")
get_target_property(_p15_tg_policy_dir strata_kernels SOURCE_DIR)
get_target_property(_p15_tg_policy_sources strata_kernels SOURCES)
set(_p15_tg_policy_parent_count 0)
set(_p15_tg_policy_child_count 0)
foreach(_p15_tg_policy_source IN LISTS _p15_tg_policy_sources)
  get_filename_component(_p15_tg_policy_abs "${_p15_tg_policy_source}" ABSOLUTE BASE_DIR "${_p15_tg_policy_dir}")
  if(_p15_tg_policy_abs STREQUAL _p15_tg_policy_parent)
    math(EXPR _p15_tg_policy_parent_count "${_p15_tg_policy_parent_count}+1")
  endif()
  if(_p15_tg_policy_abs STREQUAL _p15_tg_policy_child)
    math(EXPR _p15_tg_policy_child_count "${_p15_tg_policy_child_count}+1")
  endif()
endforeach()
if(NOT _p15_tg_policy_parent_count EQUAL 1 OR NOT _p15_tg_policy_child_count EQUAL 1)
  message(FATAL_ERROR "P15 TG policy requires exactly one registered parent and new production CU")
endif()
set(_p15_tg_policy_values "")
foreach(_p15_tg_policy_property COMPILE_OPTIONS COMPILE_FLAGS)
  # Source properties are directory scoped: read and set in the target's owner,
  # even when this late include itself executes from the top-level project.
  get_source_file_property(_p15_tg_policy_value "${_p15_tg_policy_parent}"
    TARGET_DIRECTORY strata_kernels ${_p15_tg_policy_property})
  if(NOT _p15_tg_policy_value STREQUAL "NOTFOUND")
    set_source_files_properties("${_p15_tg_policy_child}" TARGET_DIRECTORY strata_kernels
      PROPERTIES ${_p15_tg_policy_property} "${_p15_tg_policy_value}")
    get_source_file_property(_p15_tg_policy_actual "${_p15_tg_policy_child}"
      TARGET_DIRECTORY strata_kernels ${_p15_tg_policy_property})
    if(NOT _p15_tg_policy_actual STREQUAL _p15_tg_policy_value)
      message(FATAL_ERROR "P15 TG exact source property inheritance failed")
    endif()
    string(APPEND _p15_tg_policy_values ";${_p15_tg_policy_value}")
  endif()
endforeach()
string(FIND "${_p15_tg_policy_values}" "--use_fast_math" _p15_tg_policy_fastmath)
if(_p15_tg_policy_fastmath LESS 0)
  message(FATAL_ERROR "Bound actual parent TG source must declare --use_fast_math")
endif()
message(STATUS "P15 TG source policy copied exactly from native_gdn_preprocess; full Ninja edge equality remains required")
