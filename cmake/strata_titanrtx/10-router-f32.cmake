if(NOT TARGET strata_prefill OR NOT TARGET strata_qwen35moe_runtime OR NOT TARGET CUDA::cublas)
  message(FATAL_ERROR "RouterF32 requires the existing prefill/Gemm/CUDA targets")
endif()
set(_strata_router_f32_new "${CMAKE_SOURCE_DIR}/src/prefill/gemm_router_f32.cu")
get_target_property(_strata_router_f32_sources strata_prefill SOURCES)
get_target_property(_strata_router_f32_dir strata_prefill SOURCE_DIR)
set(_strata_router_f32_base_count 0)
set(_strata_router_f32_new_count 0)
foreach(_entry IN LISTS _strata_router_f32_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_strata_router_f32_dir}")
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/prefill/gemm.cu")
      math(EXPR _strata_router_f32_base_count "${_strata_router_f32_base_count}+1")
    endif()
    if(_absolute STREQUAL _strata_router_f32_new)
      math(EXPR _strata_router_f32_new_count "${_strata_router_f32_new_count}+1")
    endif()
  endif()
endforeach()
if(NOT _strata_router_f32_base_count EQUAL 1 OR _strata_router_f32_new_count GREATER 1)
  message(FATAL_ERROR "RouterF32 must share the exact existing Gemm production target")
endif()
if(_strata_router_f32_new_count EQUAL 0)
  target_sources(strata_prefill PRIVATE "${_strata_router_f32_new}")
endif()
