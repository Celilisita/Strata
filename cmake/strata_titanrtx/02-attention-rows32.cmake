if(NOT TARGET strata_qwen35moe_runtime)
  message(FATAL_ERROR "Rows32 registration requires the actual runtime target")
endif()
set(_rows32_source "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows32.cu")
get_target_property(_rows32_sources strata_qwen35moe_runtime SOURCES)
get_target_property(_rows32_source_dir strata_qwen35moe_runtime SOURCE_DIR)
set(_rows32_present FALSE)
foreach(_entry IN LISTS _rows32_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_rows32_source_dir}")
    if(_absolute STREQUAL _rows32_source)
      set(_rows32_present TRUE)
    endif()
  endif()
endforeach()
if(NOT _rows32_present)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_rows32_source}")
endif()
