if(NOT TARGET strata_qwen35moe_runtime OR NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "EarlyQpad8 requires actual Runtime/CUDA targets")
endif()
set(_early_qpad8_parent "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64_qpad8.cu")
set(_early_qpad8_child "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64_early_qpad8.cu")
get_target_property(_early_qpad8_dir strata_qwen35moe_runtime SOURCE_DIR)
get_target_property(_early_qpad8_sources strata_qwen35moe_runtime SOURCES)
set(_early_qpad8_parent_count 0)
set(_early_qpad8_child_count 0)
foreach(_early_qpad8_entry IN LISTS _early_qpad8_sources)
  if(NOT _early_qpad8_entry MATCHES "^\\$<")
    get_filename_component(_early_qpad8_absolute "${_early_qpad8_entry}" ABSOLUTE BASE_DIR "${_early_qpad8_dir}")
    if(_early_qpad8_absolute STREQUAL _early_qpad8_parent)
      math(EXPR _early_qpad8_parent_count "${_early_qpad8_parent_count}+1")
    endif()
    if(_early_qpad8_absolute STREQUAL _early_qpad8_child)
      math(EXPR _early_qpad8_child_count "${_early_qpad8_child_count}+1")
    endif()
  endif()
endforeach()
if(NOT _early_qpad8_parent_count EQUAL 1 OR _early_qpad8_child_count GREATER 1)
  message(FATAL_ERROR "EarlyQpad8 needs one actual Rows64 and at most one new CU")
endif()
if(NOT _early_qpad8_child_count)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_early_qpad8_child}")
endif()
# Copy source-level attributes in the owning target directory, without target/global overrides.
foreach(_early_qpad8_property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
  get_source_file_property(_early_qpad8_value "${_early_qpad8_parent}" TARGET_DIRECTORY strata_qwen35moe_runtime ${_early_qpad8_property})
  if(NOT _early_qpad8_value STREQUAL "NOTFOUND")
    set_source_files_properties("${_early_qpad8_child}" TARGET_DIRECTORY strata_qwen35moe_runtime PROPERTIES ${_early_qpad8_property} "${_early_qpad8_value}")
  endif()
endforeach()
# Owner must compare complete actual FLAGS/DEFINES/INCLUDES against actual Rows64 parent.
