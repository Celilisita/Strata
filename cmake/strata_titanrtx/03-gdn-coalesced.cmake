# Compose after the actual production kernel target exists; inherit its CUDA20/fastmath policy.
if(NOT TARGET strata_kernels)
  message(FATAL_ERROR "GDN production registration requires the original strata_kernels target")
endif()
set(_gdn_coalesced_source "${CMAKE_SOURCE_DIR}/src/kernels/cuda/native_gdn_coalesced.cu")
get_target_property(_gdn_kernel_sources strata_kernels SOURCES)
get_target_property(_gdn_kernel_source_dir strata_kernels SOURCE_DIR)
set(_gdn_coalesced_count 0)
foreach(_source IN LISTS _gdn_kernel_sources)
  if(NOT _source MATCHES "^\\$<")
    get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_gdn_kernel_source_dir}")
    if(_absolute STREQUAL _gdn_coalesced_source)
      math(EXPR _gdn_coalesced_count "${_gdn_coalesced_count}+1")
    endif()
  endif()
endforeach()
if(_gdn_coalesced_count GREATER 1)
  message(FATAL_ERROR "Production must own at most one coalesced GDN CU")
elseif(_gdn_coalesced_count EQUAL 0)
  target_sources(strata_kernels PRIVATE "${_gdn_coalesced_source}")
endif()
