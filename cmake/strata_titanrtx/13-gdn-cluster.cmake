if(NOT TARGET strata_kernels)
  message(FATAL_ERROR "GDN cluster requires the actual native preprocessing target")
endif()
set(_gdn_cluster_source "${CMAKE_SOURCE_DIR}/src/kernels/cuda/native_gdn_cluster.cu")
get_target_property(_gdn_sources strata_kernels SOURCES)
set(_gdn_parent_count 0)
foreach(_source IN LISTS _gdn_sources)
  if(_source MATCHES "(^|/)native_gdn_preprocess[.]cu$")
    math(EXPR _gdn_parent_count "${_gdn_parent_count}+1")
  endif()
endforeach()
if(NOT _gdn_parent_count EQUAL 1)
  message(FATAL_ERROR "Expected one actual native_gdn_preprocess CUDA policy owner")
endif()
if(NOT _gdn_cluster_source IN_LIST _gdn_sources)
  target_sources(strata_kernels PRIVATE "${_gdn_cluster_source}")
endif()
