# Root composes this after the real runtime target is declared.
if(NOT TARGET strata_qwen35moe_runtime)
  message(FATAL_ERROR "Attention Register production registration requires the real runtime target")
endif()
set(_attention_register_source "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_register.cu")
get_target_property(_attention_runtime_sources strata_qwen35moe_runtime SOURCES)
get_target_property(_attention_runtime_source_dir strata_qwen35moe_runtime SOURCE_DIR)
set(_attention_register_present FALSE)
foreach(_entry IN LISTS _attention_runtime_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_attention_runtime_source_dir}")
    if(_absolute STREQUAL _attention_register_source)
      set(_attention_register_present TRUE)
    endif()
  endif()
endforeach()
if(NOT _attention_register_present)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_attention_register_source}")
endif()
