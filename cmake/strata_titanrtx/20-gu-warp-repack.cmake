if(NOT TARGET strata_mmq OR NOT TARGET strata_qwen35moe_runtime)
  message(FATAL_ERROR "GU warp repack requires the actual production MMQ/Runtime targets")
endif()
get_target_property(_gu_warp_sources strata_mmq SOURCES)
get_target_property(_gu_warp_dir strata_mmq SOURCE_DIR)
set(_gu_warp_base 0)
set(_gu_warp_new 0)
foreach(_entry IN LISTS _gu_warp_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_gu_warp_dir}")
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/prefill/native_ordinary_grouped_mmq.cu")
      math(EXPR _gu_warp_base "${_gu_warp_base}+1")
    endif()
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/prefill/native_gu_warp_repack.cu")
      math(EXPR _gu_warp_new "${_gu_warp_new}+1")
    endif()
  endif()
endforeach()
if(NOT _gu_warp_base EQUAL 1 OR _gu_warp_new GREATER 1)
  message(FATAL_ERROR "GU warp repack must inherit exactly one existing ordinary MMQ parent")
endif()
# Source-specific parent fastmath/definitions/includes are policy, too.
set(_gu_warp_parent "${CMAKE_SOURCE_DIR}/src/prefill/native_ordinary_grouped_mmq.cu")
set(_gu_warp_candidate "${CMAKE_SOURCE_DIR}/src/prefill/native_gu_warp_repack.cu")
foreach(_property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
  get_source_file_property(_gu_warp_property "${_gu_warp_parent}" TARGET_DIRECTORY strata_mmq ${_property})
  if(_gu_warp_property AND NOT _gu_warp_property MATCHES "NOTFOUND$")
    set_source_files_properties("${_gu_warp_candidate}" TARGET_DIRECTORY strata_mmq PROPERTIES ${_property} "${_gu_warp_property}")
  endif()
endforeach()
if(_gu_warp_new EQUAL 0)
  target_sources(strata_mmq PRIVATE "${CMAKE_SOURCE_DIR}/src/prefill/native_gu_warp_repack.cu")
endif()
