if(NOT TARGET strata_qwen35moe_runtime OR NOT TARGET strata_qwen35moe_cuda)
  message(FATAL_ERROR "Rows64 registration requires actual runtime and CUDA targets")
endif()
set(_strata_rows64_production_source "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows64.cu")
get_target_property(_strata_rows64_runtime_sources strata_qwen35moe_runtime SOURCES)
get_target_property(_strata_rows64_runtime_dir strata_qwen35moe_runtime SOURCE_DIR)
set(_strata_rows64_seen FALSE)
set(_strata_rows64_baseline_count 0)
foreach(_entry IN LISTS _strata_rows64_runtime_sources)
  if(NOT _entry MATCHES "^\\$<")
    get_filename_component(_absolute "${_entry}" ABSOLUTE BASE_DIR "${_strata_rows64_runtime_dir}")
    if(_absolute STREQUAL _strata_rows64_production_source)
      set(_strata_rows64_seen TRUE)
    endif()
    if(_absolute STREQUAL "${CMAKE_SOURCE_DIR}/src/qwen35moe/cuda/attention_rows32.cu")
      math(EXPR _strata_rows64_baseline_count "${_strata_rows64_baseline_count}+1")
    endif()
  endif()
endforeach()
if(NOT _strata_rows64_baseline_count EQUAL 1)
  message(FATAL_ERROR "Actual Rows32 must belong to the same runtime target exactly once")
endif()
if(NOT _strata_rows64_seen)
  target_sources(strata_qwen35moe_runtime PRIVATE "${_strata_rows64_production_source}")
endif()
# No option overrides: inherit actual Rows32 target CUDA20, SM75-real, /W4, no fastmath.
# Owner must retain and compare full actual Ninja CUDA compile edges before build.
