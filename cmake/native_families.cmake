# Native families link into the public mainline executable. No diagnostic targets.
option(STRATA_QWEN35_MOE "Enable native Qwen35 MoE and MiniCPM variant" OFF)
option(STRATA_QWEN35_DENSE "Enable native Dense 27B" OFF)
if(NOT STRATA_QWEN35_MOE AND NOT STRATA_QWEN35_DENSE)
  return()
endif()
if(NOT TARGET strata OR NOT STRATA_ENABLE_CUDA)
  message(FATAL_ERROR "Native families require the CUDA mainline target")
endif()
add_library(strata_native_sampling STATIC src/kernels/cuda/radix_sampler.cu)
target_include_directories(strata_native_sampling PUBLIC include)
target_link_libraries(strata_native_sampling PUBLIC CUDA::cudart)
# Native MoE QKV projections may be Q6_K even when all routed experts are Q4_K.
# Admit the projection MMQ dispatch independently of the optional Q6 expert kernels.
if(STRATA_QWEN35_MOE)
  if(NOT STRATA_MMQ_KQUANTS OR NOT TARGET strata_mmq)
    message(FATAL_ERROR "Native MoE requires STRATA_MMQ_KQUANTS and the CUDA MMQ target")
  endif()
  target_compile_definitions(strata_mmq PRIVATE STRATA_NATIVE_MOE_Q6_MMQ=1)
  if(NOT STRATA_DEEPSEEK_V4 AND NOT STRATA_Q6K_EXPERTS)
    target_sources(strata_mmq PRIVATE ${_strata_mmq}/template-instances/mmq-instance-q6_k.cu)
  endif()
endif()
include(${CMAKE_CURRENT_LIST_DIR}/native_moe.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/native_dense.cmake)
