# Native families link into the public mainline executable. No diagnostic targets.
option(STRATA_QWEN35_MOE "Enable native Qwen35 MoE and MiniCPM variant" OFF)
option(STRATA_QWEN35_DENSE "Enable native Dense 27B" OFF)
option(STRATA_QWEN35_DENSE_FINAL223 "Enable the frozen SM120 Dense NVFP4 provider" OFF)
option(STRATA_GEMMA4_SM120 "Enable the independent Gemma Dense SM120 executable" OFF)
if(STRATA_GEMMA4_SM120 AND NOT STRATA_QWEN35_DENSE_FINAL223)
  message(FATAL_ERROR "Gemma SM120 requires the existing Dense FINAL223 primitive owner")
endif()
if(STRATA_QWEN35_DENSE_FINAL223 AND NOT STRATA_QWEN35_DENSE)
  message(FATAL_ERROR "FINAL223 requires STRATA_QWEN35_DENSE=ON")
endif()
if(NOT STRATA_QWEN35_MOE AND NOT STRATA_QWEN35_DENSE)
  return()
endif()
if(NOT TARGET strata OR NOT STRATA_ENABLE_CUDA)
  message(FATAL_ERROR "Native families require the CUDA mainline target")
endif()
# One sampler owner per process. Dense uses the frozen implementation, whose
# feature-off path retains the full radix chain; MoE-only builds keep their source.
if(STRATA_QWEN35_DENSE)
  include(${CMAKE_CURRENT_LIST_DIR}/native_dense_final223.cmake)
  set(_strata_native_sampler src/kernels/cuda/short_prefix_sampler.cu)
else()
  set(_strata_native_sampler src/kernels/cuda/radix_sampler.cu)
endif()
add_library(strata_native_sampling STATIC ${_strata_native_sampler})
set_target_properties(strata_native_sampling PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
if(STRATA_QWEN35_DENSE_FINAL223)
  set_target_properties(strata_native_sampling PROPERTIES CUDA_ARCHITECTURES 120a CUDA_RUNTIME_LIBRARY Shared)
  target_compile_options(strata_native_sampling PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>)
endif()
target_include_directories(strata_native_sampling PUBLIC include)
target_link_libraries(strata_native_sampling PUBLIC CUDA::cudart)
# Native MoE QKV projections may be Q6_K even when all routed experts are Q4_K.
# Admit the projection MMQ dispatch independently of the optional Q6 expert kernels.
if(STRATA_QWEN35_MOE)
  if(NOT STRATA_MMQ_KQUANTS OR NOT TARGET strata_mmq)
    message(FATAL_ERROR "Native MoE requires STRATA_MMQ_KQUANTS and the CUDA MMQ target")
  endif()
  target_compile_definitions(strata_mmq PRIVATE STRATA_NATIVE_MOE_Q6_MMQ=1)
  if(NOT STRATA_DEEPSEEK_V4 AND NOT STRATA_Q6K_EXPERTS)
    target_sources(strata_mmq PRIVATE ${_strata_mmq}/template-instances/mmq-instance-q6_k.cu)
  endif()
endif()
include(${CMAKE_CURRENT_LIST_DIR}/native_moe.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/native_dense.cmake)

if(STRATA_GEMMA4_SM120)
  include(${CMAKE_CURRENT_LIST_DIR}/native_gemma4_sm120.cmake)
  strata_add_gemma4_sm120("${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
endif()
