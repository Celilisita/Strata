if(TARGET moe-nvfp4-convert)
  return()
endif()
set(STRATA_MOE_CONVERTER_ROOT "${CMAKE_CURRENT_LIST_DIR}")
function(strata_add_moe_nvfp4_converter)
  add_library(moe-nvfp4-convert SHARED "${STRATA_MOE_CONVERTER_ROOT}/convert_moe_nvfp4.cu")
  target_compile_features(moe-nvfp4-convert PRIVATE cxx_std_17 cuda_std_17)
  set_target_properties(moe-nvfp4-convert PROPERTIES CUDA_ARCHITECTURES 120 CUDA_RUNTIME_LIBRARY Shared OUTPUT_NAME moe_nvfp4_convert)
endfunction()
cmake_language(DEFER CALL strata_add_moe_nvfp4_converter)
